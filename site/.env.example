# ShopTrolley signup email relay — copy to .env and fill in
# (site/.env is gitignored; this file is the safe template)

# SMTP server for the mailbox that will SEND the signup notifications.
# Examples: smtp.gmail.com, smtp.zoho.com, smtp-mail.outlook.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Login / From address (use an App Password, not your normal password)
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# "1" for implicit SSL (port 465), leave empty for STARTTLS (port 587)
SMTP_USE_SSL=

# Where signup notifications are delivered (defaults to SMTP_USER)
MAIL_TO=you@gmail.com

# Port the marketing site runs on
PORT=8090
