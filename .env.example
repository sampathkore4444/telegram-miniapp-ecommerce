# --- App ---
APP_NAME=Telegram Shop
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME__use_a_long_random_string__openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Telegram ---
# Bot token from @BotFather. Required to validate Telegram WebApp initData.
TELEGRAM_BOT_TOKEN=
# Bot @username (without the leading @) used for store links/branding.
TELEGRAM_BOT_USERNAME=
# Comma separated Telegram user ids granted the OWNER/ADMIN role.
ADMIN_TELEGRAM_IDS=
# Max age (seconds) of a valid Telegram auth payload.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# --- Database ---
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop
POSTGRES_PORT=5436
# Used only when running the backend outside docker-compose.
DATABASE_URL=postgresql+asyncpg://shop:shop@127.0.0.1:5436/shop

# --- Backend ---
BACKEND_PORT=8003
WORKERS=4
# Comma separated list of allowed browser origins (for dev UI served elsewhere). "*" disables checks.
CORS_ORIGINS=*

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=5

# --- Store defaults (first boot; editable later in Admin -> Settings) ---
STORE_CURRENCY=USD
STORE_CURRENCY_SYMBOL=$
